{
  "identifier": "manager-local-only",
  "description": "Grant account management commands strictly to the local manager webview",
  "local": true,
  "windows": ["main", "manager"],
  "webviews": ["manager"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-manager-state",
    "allow-select-provider",
    "allow-add-account",
    "allow-rename-account",
    "allow-test-account-proxy",
    "allow-copy-account-cookie",
    "allow-import-account-cookies",
    "allow-remove-account",
    "allow-reorder-accounts",
    "allow-reload-account",
    "allow-clear-account-data",
    "allow-reveal-downloaded-file",
    "allow-switch-account",
    "allow-set-modal-active",
    "allow-open-official-site",
    "allow-resolve-uuid-conflict",
    "allow-dismiss-notice",
    "allow-trigger-quota-sync",
    "allow-update-app-settings",
    "allow-select-group-chat",
    "allow-create-group-chat",
    "allow-update-group-chat",
    "allow-delete-group-chat",
    "allow-send-group-message",
    "allow-retry-group-message",
    "allow-sync-group-message-reply",
    "allow-clear-group-messages",
    "allow-start-group-new-topic",
    "allow-update-group-knowledge",
    "allow-append-group-shared-context",
    "allow-upsert-external-agent",
    "allow-delete-external-agent",
    "allow-update-group-workflow",
    "allow-reset-group-thread-binding",
    "allow-get-site-adapters",
    "allow-save-site-adapter-overrides",
    "allow-reset-site-adapter-overrides",
    "allow-check-for-updates",
    "allow-download-and-install-update",
    "allow-open-external-url",
    "allow-export-sync-bundle",
    "allow-import-sync-bundle",
    "allow-start-lan-sync-share",
    "allow-start-relay-sync-share",
    "allow-stop-lan-sync-share",
    "allow-pull-lan-sync-share",
    "allow-scan-sync-qr-code",
    "allow-test-webdav-sync",
    "allow-push-webdav-sync",
    "allow-pull-webdav-sync"
  ]
}
